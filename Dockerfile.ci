# syntax=docker/dockerfile:1
# CI 专用：用 buildx 的 $BUILDPLATFORM 交叉编译，一次产出 amd64 + arm64 镜像，
# 不需要 QEMU 模拟跑 Go 编译器，构建时间从十几分钟降到两三分钟。
# 本地/服务器上仍然可以用原来的 Dockerfile 直接 go build。
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/usdt-scanner ./cmd/usdt-scanner \
 && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/usdt-deploy ./cmd/usdt-deploy

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 scanner
COPY --from=build /out/ /usr/local/bin/
USER scanner
VOLUME /data
ENV DATA_DIR=/data LISTEN_ADDR=0.0.0.0:9180
HEALTHCHECK --interval=60s --timeout=5s CMD wget -qO- http://127.0.0.1:9180/ || exit 1
ENTRYPOINT ["usdt-scanner"]
