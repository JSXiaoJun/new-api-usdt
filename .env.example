# ---- new-api ----
# Root URL of your new-api site (no sub-path).
NEWAPI_URL=https://your-new-api.example.com
# new-api backend → USDT settings → "Generate scanner secret".
SCANNER_SECRET=

# ---- gas wallet (pays sweep fees only; it can never move USDT elsewhere) ----
# Create one with: docker compose run --rm --entrypoint usdt-deploy usdt-scanner new-key
# Fund it with a few dollars of BNB (BSC), ETH (Arbitrum), POL (Polygon), TRX (TRON).
GAS_PRIVATE_KEY=
SWEEP_ENABLED=true

# ---- RPC endpoints (comma-separated for failover) ----
# Use a different provider here than the one configured in new-api, so a
# single compromised provider cannot both report and confirm a fake deposit.
RPC_BSC=
RPC_ARBITRUM=
RPC_POLYGON=
# TRON JSON-RPC, e.g. https://api.trongrid.io/jsonrpc
RPC_TRON=
# TRON HTTP API used to send TRON sweeps.
TRON_API=https://api.trongrid.io
TRON_API_KEY=
# Maximum TRX burned by one TRON sweep transaction.
TRON_FEE_LIMIT_TRX=50

# ---- tuning (optional) ----
POLL_SECONDS=10
# MAX_RANGE_BSC=1000
# CATCHUP_BLOCKS_BSC=1000
# LOOKBACK_BLOCKS_BSC=2000
# START_BLOCK_BSC=
# MAX_GAS_PRICE_WEI_BSC=10000000000

# ---- email alerts (optional; leave SMTP_HOST empty to disable) ----
# QQ/163: use the "authorization code" (授权码) as SMTP_PASS, not the login password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER.
MAIL_FROM=
# Comma separated recipients.
MAIL_TO=
# Same alert key is sent at most once per window (6h default).
ALERT_COOLDOWN_SECONDS=21600
# Gas wallet floors per chain (native coin). Defaults: polygon 0.2, bsc 0.01,
# arbitrum 0.0005, tron 20.
# ALERT_GAS_MIN_POLYGON=0.2
# ALERT_GAS_MIN_BSC=0.01
# Alert when setDestination picks something other than this address.
# ALERT_EXPECTED_DESTINATION_POLYGON=0x...
# Daily summary time, scanner local time (container defaults to UTC unless TZ is set).
ALERT_DAILY_HOUR=20
ALERT_DAILY_MINUTE=0

# Container timezone (daily summary and log timestamps use it).
TZ=Asia/Shanghai

# Collection wallet: notify every time its balance crosses a multiple of this
# value, and on any decrease. Default 100.
# ALERT_DESTINATION_STEP_POLYGON=100
# Gas alerts are expressed as "sweeps remaining": warn when fewer than this many
# sweeps are affordable, and repeat every ALERT_GAS_REPEAT_SECONDS until topped up.
# ALERT_SWEEP_LEFT_POLYGON=30
# ALERT_GAS_REPEAT_SECONDS=1800
# Native coin one sweep is assumed to burn (defaults: polygon 0.03, bsc 0.0002,
# arbitrum 0.0002, tron 2).
# ALERT_SWEEP_COST_POLYGON=0.03

# How often to ask new-api for new deposit addresses / settings (seconds, min 5).
# Larger = less chatty but new addresses are learned later, delaying first credit.
# SYNC_SECONDS=30
